# Database (PostgreSQL - Supabase / Neon / Railway)
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# NextAuth Authentication (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-auth-key-32-chars-minimum"
NEXTAUTH_SECRET="your-super-secret-auth-key-32-chars-minimum"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Optional: Supabase Storage for Image Uploads
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
