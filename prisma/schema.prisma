// This is the Threadinery Prisma schema.
// See instruction.md §6 for the full data model spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth & akun ──────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  projects  Project[]
}

// ── Project & buku ───────────────────────────
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  genre       String?
  subGenre    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  books         Book[]
  entityTypes   EntityType[]
  entities      Entity[]
  relationships Relationship[]
  events        Event[]
  maps          Map[]
  chapters      Chapter[]
}

model Book {
  id         String @id @default(cuid())
  projectId  String
  title      String
  orderIndex Int    @default(0)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters Chapter[]
  events   Event[]
}

// ── Entity system ────────────────────────────
model EntityType {
  id        String  @id @default(cuid())
  projectId String
  name      String
  isDefault Boolean @default(false)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entities Entity[]
}

model Entity {
  id          String   @id @default(cuid())
  projectId   String
  typeId      String
  name        String
  description String?
  imageUrl    String?
  tags        String[]
  metadata    Json?
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type    EntityType @relation(fields: [typeId], references: [id])

  relationshipsFrom Relationship[]    @relation("SourceEntity")
  relationshipsTo   Relationship[]    @relation("TargetEntity")
  eventLinks        EventEntity[]
  location          EntityLocation?
  statusChanges     EntityStatusLog[]
}

// ── Relationship ─────────────────────────────
model Relationship {
  id             String   @id @default(cuid())
  projectId      String
  sourceEntityId String
  targetEntityId String
  label          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source       Entity                    @relation("SourceEntity", fields: [sourceEntityId], references: [id])
  target       Entity                    @relation("TargetEntity", fields: [targetEntityId], references: [id])
  changeLog    RelationshipLog[]
  eventChanges EventRelationshipChange[]
}

model RelationshipLog {
  id             String   @id @default(cuid())
  relationshipId String
  oldLabel       String
  newLabel       String
  changedAt      DateTime @default(now())
  eventId        String?

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id])
}

model EntityStatusLog {
  id        String   @id @default(cuid())
  entityId  String
  oldStatus String?
  newStatus String?
  changedAt DateTime @default(now())
  eventId   String?

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id])
}

// ── Event ─────────────────────────────────────
model Event {
  id          String  @id @default(cuid())
  projectId   String
  bookId      String?
  name        String
  description String?
  worldDate   String?

  chapterId      String?
  orderInChapter Int?
  writingStatus  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  book                Book?                     @relation(fields: [bookId], references: [id])
  chapter             Chapter?                  @relation(fields: [chapterId], references: [id])
  entitiesInvolved    EventEntity[]
  relationshipChanges EventRelationshipChange[]
  statusChanges       EntityStatusLog[]
  relationshipLogs    RelationshipLog[]
}

model EventEntity {
  eventId  String
  entityId String
  role     String?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([eventId, entityId])
}

model EventRelationshipChange {
  id             String  @id @default(cuid())
  eventId        String
  relationshipId String
  beforeLabel    String?
  afterLabel     String

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
}

// ── Outline ───────────────────────────────────
model Chapter {
  id         String  @id @default(cuid())
  projectId  String
  bookId     String
  orderIndex Int     @default(0)
  title      String
  summary    String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  events  Event[]
}

// ── Map ───────────────────────────────────────
model Map {
  id        String @id @default(cuid())
  projectId String
  name      String
  imageUrl  String
  width     Int
  height    Int

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locations EntityLocation[]
}

model EntityLocation {
  entityId String @id
  mapId    String
  x        Float
  y        Float

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  map    Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)
}
